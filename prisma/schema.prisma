// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  role         String     @default("BUSINESS_OWNER") // "SUPER_ADMIN" | "BUSINESS_OWNER" | "AGENCY"
  phone        String?
  businesses   Business[]
  agency       Agency?
  referralCode String?    @unique
  referredBy   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Business {
  id                         String          @id @default(cuid())
  ownerId                    String
  owner                      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                       String
  slug                       String          @unique
  category                   String?         @default("General Business") // e.g. "IT & Software", "Restaurant / Cafe", "Dental Clinic", "Salon & Spa"
  bio                        String?         // Brief 1-2 sentence description of products/services for AI review generator
  services                   String?         @default("Custom Web Development, Mobile Apps, UI/UX Design, Cloud Solutions") // Comma-separated list of services/products
  logoUrl                    String?
  bannerUrl                  String?
  primaryColor               String          @default("#2563eb")
  googleReviewUrl            String          @default("https://maps.google.com")
  placeId                    String?
  minPositiveRating          Int             @default(4) // 3, 4, or 5 stars threshold
  isActive                   Boolean         @default(true) // Super Admin status toggle
  
  // Feedback collection settings
  collectFeedbackOnLowRating Boolean         @default(true) // Client toggle: collect private feedback or just thank customer
  issueCategories            String?         @default("Service Speed, Product Quality, Staff Behavior, Cleanliness & Hygiene, Pricing / Billing, Other Issue")
  
  // AI Review Assistant & Dynamic Praise Tags
  enableAiReview             Boolean         @default(true) // Client toggle: show AI review suggestions on high ratings
  enableServices             Boolean         @default(true) // Client toggle: show services/products chips to customers
  enablePositiveTags         Boolean         @default(true) // Client toggle: show praise/what did you like best chips
  enableLanguageSelection    Boolean         @default(true) // Client toggle: show language selector chips to customers
  selectedLanguages          String?         @default("English, Hinglish, Hindi, Gujarati, Marathi, Punjabi, Bengali, Tamil, Telugu, Arabic, Spanish") // Whitelisted languages
  positiveTags               String?         @default("Top Quality, Fast Delivery, Great Support, Professional Team, Highly Recommended")
  
  // Apology Voucher settings
  enableDiscountOffer        Boolean         @default(true) // Client toggle: show apology discount voucher or not
  discountOfferTitle         String?         @default("Special 10% Discount Offer")
  discountOfferCode          String?         @default("THANKYOU10")
  discountOfferText          String?         @default("Thank you for helping us improve! Show this voucher code on your next visit to get 10% off.")
  
  // Standee Customization
  standeeTemplate            String          @default("modern_gradient") // "modern_gradient", "luxury_gold", "minimal_bold", "emerald_fresh"
  standeeTagline             String          @default("Loved your visit? Share your feedback!")
  
  // SaaS Plan details
  planName                   String          @default("Pro Plan")
  planPrice                  String?         @default("₹999/mo")
  planExpiresAt              DateTime?
  monthlyScanLimit           Int             @default(500) // -1 for Unlimited, or positive integer (e.g. 100, 500, 1000, 10000)
  
  // Agency / Reseller & Auto-Renew Features
  agencyId                   String?
  agency                     Agency?         @relation("AgencyBusinesses", fields: [agencyId], references: [id], onDelete: SetNull)
  autoRenew                  Boolean         @default(true) // Per-client auto-renew toggle
  wholesalePlanId            String?
  wholesalePlan              WholesalePlan?  @relation(fields: [wholesalePlanId], references: [id], onDelete: SetNull)
  billingCycleDays           Int             @default(30) // 30 for monthly, 365 for yearly
  referralCode               String?
  referredBy                 String?

  // Alerts
  notificationEmail          String?
  notificationPhone          String?
  whatsappAlertEnabled       Boolean         @default(true)
  
  // Custom messages
  positiveMessage            String?         @default("We're thrilled you had a great experience! Would you take 10 seconds to share your review on Google?")
  negativeMessage            String?         @default("We are truly sorry that we didn't meet your expectations. Please share your private feedback with our management team directly so we can resolve this immediately.")
  
  feedbacks                  Feedback[]
  scans                      ScanAnalytics[]
  transactions               SubscriptionTransaction[]
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

model Feedback {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating         Int
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  issueCategory  String?   // "Food/Product Quality", "Service Speed", "Staff Behavior", "Cleanliness", "Pricing", "Other"
  comment        String
  status         String    @default("PENDING") // "PENDING", "CONTACTED", "RESOLVED"
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ScanAnalytics {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ratingSelected Int?
  action         String    @default("PAGE_VIEW") // "PAGE_VIEW", "REDIRECTED_GOOGLE", "SUBMITTED_FEEDBACK", "LOW_RATING_NO_FEEDBACK"
  userAgent      String?
  createdAt      DateTime  @default(now())
}

model SystemSetting {
  id             String    @id @default("global_config")
  aiProvider     String    @default("gemini") // "gemini", "openai", "smart_randomizer"
  geminiApiKey   String?
  geminiModel    String?   @default("gemini-3.5-flash-lite") // "gemini-3.5-flash-lite", "gemini-3.6-flash", "gemini-3.5-flash"
  openAiApiKey   String?
  openAiModel    String?   @default("gpt-4o-mini") // "gpt-4o-mini", "gpt-4o"
  aiCustomPrompt String?
  updatedAt      DateTime  @updatedAt
}

model Plan {
  id               String    @id @default(cuid())
  name             String    @unique
  price            String    @default("₹999/mo")
  durationDays     Int       @default(365)
  monthlyScanLimit Int       @default(500) // -1 for Unlimited
  features         String    @default("AI Smart Review Generator, QR Standee Studio, Private Negative Feedback Gating, WhatsApp & Email Alerts, Custom Discount Offers")
  badge            String?   // e.g. "Most Popular", "Best Value", "Starter"
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SubscriptionTransaction {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planName      String
  amount        String
  durationDays  Int
  status        String    @default("PAID") // "PAID", "ACTIVE", "EXTENDED", "EXPIRED"
  paymentMethod String?   @default("DIRECT_ADMIN")
  notes         String?
  createdAt     DateTime  @default(now())
}

model Agency {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  ownerId            String                    @unique
  owner              User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  walletBalance      Float                     @default(0.0)
  brandName          String?
  logoUrl            String?
  themeColor         String?                   @default("#2563eb")
  customFooterText   String?                   @default("Powered by Onetech Partner")
  customFooterUrl    String?                   @default("https://onetechsolution.in")
  supportEmail       String?
  supportPhone       String?
  isActive           Boolean                   @default(true)
  referralCode       String?                   @unique
  referredBy         String?
  businesses         Business[]                @relation("AgencyBusinesses")
  walletTransactions AgencyWalletTransaction[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model AgencyWalletTransaction {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  amount       Float    // Positive for topup, negative for deduction
  type         String   // "TOPUP", "CLIENT_PURCHASE", "CLIENT_RENEWAL", "REFERRAL_BONUS", "WITHDRAWAL"
  description  String
  clientName   String?
  balanceAfter Float
  createdAt    DateTime @default(now())
}

model WholesalePlan {
  id               String     @id @default(cuid())
  name             String     @unique
  pricePerMonth    Float      @default(199.0)
  pricePerYear     Float      @default(1999.0)
  monthlyScanLimit Int        @default(500) // -1 for Unlimited
  description      String?
  isActive         Boolean    @default(true)
  businesses       Business[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

